# Local: rode "npx supabase start" e copie os valores de "npx supabase status -o env" (API_URL, PUBLISHABLE_KEY/ANON_KEY, SECRET_KEY/SERVICE_ROLE_KEY)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Só para testes de banco, E2E e scripts locais. Nunca usar no código do app nem colocar na Netlify.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Avisos (push), e-mails e a tarefa que entrega os avisos ---
# Todas opcionais: sem valor, o recurso fica desligado e o app continua funcionando.
# Nenhuma delas vai para o repositório com valor.

# Segredo da tarefa dos avisos. Gere, nunca escolha:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Fica só no ambiente do servidor do app. O banco guarda apenas o SHA-256 dele.
JOB_SECRET=

# Chaves do push (VAPID). Gere o par com: npx web-push generate-vapid-keys
# A pública vai para o navegador; a privada fica só no servidor (nunca com NEXT_PUBLIC_).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato de quem envia os avisos, exigido pelos serviços de push: "mailto:voce@exemplo.com" ou um endereço https.
VAPID_SUBJECT=

# Servidor de e-mail (SMTP). Local: a caixa de e-mail do Supabase (veja em http://127.0.0.1:54324):
#   SMTP_HOST=127.0.0.1, SMTP_PORT=54325, sem usuário e sem senha.
SMTP_HOST=
# Porta (padrão 587).
SMTP_PORT=
# "true" só quando a porta já começa cifrada (465). Fora da máquina local, a conexão é sempre cifrada.
SMTP_SECURE=
# Usuário e senha: os dois ou nenhum.
SMTP_USER=
SMTP_PASS=
# Remetente dos e-mails, por exemplo: Íris <nao-responda@seu-dominio.com>
MAIL_FROM=
